{
	"name": "@juwel-development/design-system",
	"version": "2.1.0",
	"type": "module",
	"description": "Shared design system: tokens and components.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/juwel-development/LIB-design-system.git"
	},
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=22.12.0"
	},
	"main": "dist/design-system.js",
	"module": "dist/design-system.js",
	"types": "dist/types/index.d.ts",
	"files": [
		"dist",
		"src",
		"!src/**/*.spec.*",
		"!src/**/*.stories.*"
	],
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"import": "./dist/design-system.js",
			"default": "./dist/design-system.js"
		},
		"./styles.css": "./src/styles.css",
		"./styles.light.css": "./src/styles.light.css",
		"./styles.dark.css": "./src/styles.dark.css",
		"./tokens.css": "./src/tokens.css",
		"./tokens.light.css": "./src/tokens.light.css",
		"./tokens.dark.css": "./src/tokens.dark.css",
		"./package.json": "./package.json"
	},
	"scripts": {
		"build:tokens": "tsx scripts/build-tokens.ts",
		"build:components": "vite build",
		"build:types": "tsc -p tsconfig.build.json --emitDeclarationOnly --declarationDir dist/types",
		"build": "npm run build:components && npm run build:types",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"sandcastle": "tsx .sandcastle/main.ts",
		"sandcastle:image": "sandcastle docker build-image",
		"fallow": "fallow",
		"fallow:human": "fallow dead-code && fallow dupes && fallow health",
		"fallow:agent": "fallow review --brief",
		"fallow:map": "fallow viz",
		"prepare": "husky"
	},
	"dependencies": {
		"class-variance-authority": "^0.7.1"
	},
	"peerDependencies": {
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"rxjs": "^7.8.2"
	},
	"devDependencies": {
		"@ai-hero/sandcastle": "^0.12.0",
		"@biomejs/biome": "^2.5.7",
		"@commitlint/cli": "^21.2.1",
		"@commitlint/config-conventional": "^21.2.0",
		"@semantic-release/changelog": "^7.0.0",
		"@semantic-release/git": "^11.0.1",
		"@storybook/addon-a11y": "^10.5.7",
		"@storybook/addon-docs": "^10.5.7",
		"@storybook/addon-themes": "^10.5.7",
		"@storybook/react-vite": "^10.5.7",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/jest-dom": "^7.0.0",
		"@testing-library/react": "^16.3.2",
		"@types/node": "^26.0.0",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"@vitejs/plugin-react": "^5.1.0",
		"@vitest/coverage-v8": "^4.1.10",
		"fallow": "^3.14.0",
		"husky": "^9.1.7",
		"jsdom": "^30.0.1",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"rxjs": "^7.8.2",
		"semantic-release": "^25.0.9",
		"storybook": "^10.5.7",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.23.11",
		"typescript": "^5.9.2",
		"vite": "^8.2.1",
		"vite-plugin-lib-inject-css": "^2.2.2",
		"vitest": "^4.1.10",
		"zod": "^4.4.3"
	},
	"overrides": {
		"fallow-type-aware": {
			"typescript": "7.0.2"
		}
	}
}
